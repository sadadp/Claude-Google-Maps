# ---------- Obligatorias ----------
ANTHROPIC_API_KEY=sk-ant-...
VERCEL_TOKEN=
EVOLUTION_API_KEY=cambia-esta-clave-larga-y-aleatoria

# Necesaria para --source places (Google Places API New, habilitada en Google Cloud)
GOOGLE_MAPS_API_KEY=

# ---------- Anthropic ----------
# Claude 3.5 Sonnet fue retirado; Sonnet 5.5 es el Sonnet actual.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=32000

# ---------- Ingesta ----------
PLACES_LANGUAGE=es
MIN_REVIEWS=5

# ---------- Vercel ----------
# VERCEL_TEAM_ID=team_xxx
# Prefijo opcional del nombre del proyecto (p.ej. "preview-")
VERCEL_PROJECT_PREFIX=
VERCEL_READY_TIMEOUT_S=180

# ---------- Evolution API ----------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=outreach
VERIFY_WHATSAPP_NUMBERS=true

# Postgres para docker-compose (Evolution API)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution
POSTGRES_DB=evolution

# ---------- Outreach ----------
JITTER_MIN_S=60
JITTER_MAX_S=180
DAILY_SEND_CAP=30
SENDER_NAME=
OPT_OUT_FOOTER=Si prefieres no recibir más mensajes, respóndeme "no" y no vuelvo a escribir.

# ---------- Persistencia ----------
DATABASE_PATH=leads.db
OUTPUT_DIR=output
MAX_ATTEMPTS=3
